#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-}"
CALLER="${SUDO_USER:-}"
[[ $EUID -eq 0 && -n "$CALLER" && "$CALLER" != root ]] || { echo 'Must be called through sudo by a regular user.' >&2; exit 1; }
[[ "$ACTION" == setup || "$ACTION" == teardown ]] || { echo 'Usage: smb-mount-manager setup|teardown' >&2; exit 2; }

HOME_DIR="$(getent passwd "$CALLER" | cut -d: -f6)"
UID_NUM="$(id -u "$CALLER")"
GID_NUM="$(id -g "$CALLER")"
CONFIG="$HOME_DIR/.config/smb-mounts/mounts.conf"
BASE="/mnt/users/$CALLER"
UNIT_DIR="/run/systemd/system"
UNIT_PREFIX="bazzite-nuc355-smb-${UID_NUM}-"

[[ -n "$HOME_DIR" && "$HOME_DIR" == /* ]] || exit 1

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }
valid_name() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ && "$1" != . && "$1" != .. ]]; }
validate_options() {
  local list="$1" item
  [[ -z "$list" ]] && return 0
  IFS=',' read -ra items <<< "$list"
  for item in "${items[@]}"; do
    case "$item" in
      ro|rw|soft|serverino|noserverino|nounix|seal|cache=none|cache=strict|cache=loose|vers=2.1|vers=3.0|vers=3.02|vers=3.1.1) ;;
      *) echo "Unsafe or unsupported CIFS option: $item" >&2; return 1 ;;
    esac
  done
}

unit_id() { printf '%s' "$1" | sed 's/[^A-Za-z0-9_.-]/_/g'; }

remove_units() {
  local unit
  shopt -s nullglob
  for unit in "$UNIT_DIR/${UNIT_PREFIX}"*.automount; do
    systemctl stop "$(basename "$unit")" >/dev/null 2>&1 || true
  done
  for unit in "$UNIT_DIR/${UNIT_PREFIX}"*.mount; do
    systemctl stop "$(basename "$unit")" >/dev/null 2>&1 || true
  done
  rm -f "$UNIT_DIR/${UNIT_PREFIX}"*.automount "$UNIT_DIR/${UNIT_PREFIX}"*.mount
  systemctl daemon-reload
}

if [[ "$ACTION" == teardown ]]; then
  remove_units
  exit 0
fi

remove_units
[[ -f "$CONFIG" ]] || exit 0
[[ "$(stat -c %U "$CONFIG")" == "$CALLER" ]] || { echo "Ignoring $CONFIG: wrong owner." >&2; exit 1; }

mkdir -p "$BASE"
chown "$CALLER:$GID_NUM" "$BASE"
chmod 0700 "$BASE"

process_share() {
  local name="$1" share="$2" mount_name="$3" cred_name="$4" options="$5"
  [[ -n "$name" ]] || return 0
  [[ "$share" == //*/* ]] || { echo "[$name] invalid SMB share: $share" >&2; return 1; }
  valid_name "$mount_name" || { echo "[$name] invalid mount name." >&2; return 1; }
  valid_name "$cred_name" || { echo "[$name] invalid credentials name." >&2; return 1; }
  validate_options "$options" || return 1

  local target="$BASE/$mount_name" cred="$HOME_DIR/.config/smb-mounts/credentials/$cred_name"
  local id mount_unit automount_unit opts
  mkdir -p "$target"; chown "$CALLER:$GID_NUM" "$target"

  [[ -f "$cred" ]] || { echo "[$name] credentials missing: $cred" >&2; return 1; }
  [[ "$(stat -c %U "$cred")" == "$CALLER" ]] || { echo "[$name] credentials have wrong owner." >&2; return 1; }
  local mode; mode="$(stat -c %a "$cred")"
  (( (8#$mode & 077) == 0 )) || { echo "[$name] credentials must not be accessible by group/others (chmod 600)." >&2; return 1; }

  id="$(unit_id "$mount_name")"
  mount_unit="${UNIT_PREFIX}${id}.mount"
  automount_unit="${UNIT_PREFIX}${id}.automount"
  opts="credentials=$cred,uid=$UID_NUM,gid=$GID_NUM,iocharset=utf8,_netdev,nosuid,nodev,noexec"
  [[ -n "$options" ]] && opts="$opts,$options"

  cat > "$UNIT_DIR/$mount_unit" <<EOF
[Unit]
Description=SMB share $name for $CALLER
After=network-online.target
Wants=network-online.target

[Mount]
What=$share
Where=$target
Type=cifs
Options=$opts
TimeoutSec=15
EOF

  cat > "$UNIT_DIR/$automount_unit" <<EOF
[Unit]
Description=Automount SMB share $name for $CALLER

[Automount]
Where=$target
TimeoutIdleSec=300

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl start "$automount_unit"
  echo "[$name] automount ready at $target"
}

section='' share='' mount_name='' cred_name='' options=''
flush() { [[ -z "$section" ]] || process_share "$section" "$share" "${mount_name:-$section}" "${cred_name:-$section}" "$options"; }
while IFS= read -r raw || [[ -n "$raw" ]]; do
  line="$(trim "$raw")"
  [[ -z "$line" || "$line" == \#* || "$line" == \;* ]] && continue
  if [[ "$line" =~ ^\[([^][]+)\]$ ]]; then
    flush
    section="${BASH_REMATCH[1]}"; share=''; mount_name=''; cred_name=''; options=''
    continue
  fi
  [[ "$line" == *=* ]] || continue
  key="$(trim "${line%%=*}")"; value="$(trim "${line#*=}")"
  case "$key" in
    share) share="$value" ;;
    mount) mount_name="$value" ;;
    credentials) cred_name="$value" ;;
    options) options="$value" ;;
  esac
done < "$CONFIG"
flush
