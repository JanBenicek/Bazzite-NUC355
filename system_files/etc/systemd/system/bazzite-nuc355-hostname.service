[Unit]
Description=Set Bazzite NUC355 hardware-based hostname
After=local-fs.target
Before=NetworkManager.service network-pre.target
Wants=network-pre.target
ConditionPathExists=/usr/libexec/bazzite-nuc355/set-hardware-hostname.sh

[Service]
Type=oneshot
ExecStart=/usr/libexec/bazzite-nuc355/set-hardware-hostname.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
